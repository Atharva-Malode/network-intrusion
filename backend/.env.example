# "Explain this" uses an LLM. It tries Gemini first, then Groq, then a built-in
# local (non-AI) summary. Set EITHER key (or both); leave both blank to use the
# local fallback. No key is ever logged or returned to the client.

# --- Google Gemini (primary) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Any current model id. NOTE: the gemini-1.5-* family was retired by Google.
GEMINI_MODEL=gemini-2.5-flash

# --- Groq (fallback, OpenAI-compatible) ---
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Any current Groq chat model id (list them at
# GET https://api.groq.com/openai/v1/models with your key).
GROQ_MODEL=openai/gpt-oss-20b
